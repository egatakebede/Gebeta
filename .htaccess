# Block access to sensitive files
<FilesMatch "(\.env|\.env\.example|gebeta\.sql|composer\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory listing
Options -Indexes

# PHP error display off in production
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Environment variables (set these in your hosting panel or vhost config instead)
# SetEnv DB_HOST 127.0.0.1
# SetEnv DB_NAME gebeta
# SetEnv DB_USER gebeta_user
# SetEnv DB_PASS your_strong_password
# SetEnv BREVO_API_KEY your_brevo_api_key
# SetEnv BREVO_SENDER_EMAIL noreply@yourdomain.com
